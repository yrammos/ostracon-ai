#!/bin/sh
#
# Wire this checkout into the machine (macOS). Idempotent; the dotfiles
# installer runs it. Prints one line per item: what it did, or why not.
#
#   ~/.local/bin/bib-audit   dev/bib_audit.py on PATH; dotfiles' nrch imports it through this link
#   ~/.local/share/ostracon-ai/bib_validate.py
#                            the biber data-model validator, for other repositories to import
#                            (dotfiles' bib-validate.py) instead of keeping a copy
#   Finder Quick Action      rebuilt by dev/install_service.py when missing or older than
#                            it or automator/script.sh (copied by hand from the .example);
#                            a build relaunches Finder, so it is skipped when current

set -eu

here="$(cd "$(dirname "$0")" && pwd -P)"

say() { printf 'install: %s\n' "$*"; }

# Link $1 at $2, saying whether the link was already right.
link() {
    mkdir -p "$(dirname "$2")"
    if [ -L "$2" ] && [ "$(readlink "$2")" = "$1" ]; then
        say "ok       $2"
    else
        ln -sfn "$1" "$2"
        say "linked   $2 -> $1"
    fi
}

link "$here/dev/bib_audit.py"     "$HOME/.local/bin/bib-audit"
link "$here/src/bib_validate.py"  "${XDG_DATA_HOME:-$HOME/.local/share}/ostracon-ai/bib_validate.py"

wflow="$HOME/Library/Services/Extract BibLaTeX-Chicago Bibliography (via Claude).workflow/Contents/document.wflow"
if [ ! -f "$here/automator/script.sh" ]; then
    say "skipped  Quick Action: create automator/script.sh from its .example, then rerun" >&2
elif [ ! -f "$wflow" ] ||
     [ "$here/automator/script.sh" -nt "$wflow" ] ||
     [ "$here/dev/install_service.py" -nt "$wflow" ]; then
    say "building Quick Action (relaunches Finder)"
    python3 "$here/dev/install_service.py"
else
    say "ok       Quick Action (current; not rebuilt)"
fi
