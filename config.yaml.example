# Configuration for Bibliographic Extractor
# Copy this file to config.yaml and edit with your settings:
#   cp config.yaml.example config.yaml

# Your Anthropic API key. Get one at: https://console.anthropic.com/settings/keys
# Recommended: name a command that prints the key, so config.yaml holds no
# secret. It runs without a shell; its first line of output is the key. The
# Quick Action's PATH is minimal, so give a program outside /usr/bin by its full
# path (~ is expanded).
# Any command that prints the key works, for instance
#   ~/.local/bin/secret biblio-ai   (a helper script of your own)
#   pass show biblio-ai             (pass)
# The default below reads the macOS Keychain; store the key there first with
#   security add-generic-password -s biblio-ai -a "$USER" -w
anthropic_api_key_command: "security find-generic-password -s biblio-ai -w"
# Alternatively, the key itself. Order of precedence: anthropic_api_key,
# then $ANTHROPIC_API_KEY, then anthropic_api_key_command.
# anthropic_api_key: "sk-ant-api03-REPLACE_WITH_YOUR_KEY"

# Paths
pdf_in_folder: "./pdf-in" # Incoming PDFs to process
pdf_out_folder: "./pdf-out" # Processed PDFs moved here
main_bib_file: "~/Desktop/biblio-staging.bib"
failed_bib_file: "~/Desktop/biblio-failed.bib"
template_file: "./prompt-context/biblio-template.bib"
rules_file: "./prompt-context/extraction-rules.md" # The generic extraction rules
# Your own conventions, sent after the rules and taking precedence over them.
# Read from ~/.config/ostracon-ai/house-style.md when present; set this to
# use another file.
# house_style_file: "~/.config/ostracon-ai/house-style.md"
ref_file: "./prompt-context/biblatex-chicago-notes-ref.md"  # Optional: condensed biblatex-chicago field reference

# Optional worked-example corpora, cached as part of the static prompt prefix.
# These teach entry-TYPE discrimination (why @Inproceedings and not
# @Incollection) rather than field vocabulary. Both are derived from the
# biblatex-chicago package's own documentation; notes-test.bib carries an
# `annote` on nearly every entry explaining the choice of type and fields.
# Comment out to reduce the cached prefix size.
# example_files:   # dropped 2026-11-04: the closed type list replaces them
#   - path: "./prompt-context/notes-test.bib"
#     label: "biblatex-chicago annotated test suite"
#   - path: "./prompt-context/cms-notes-intro-guide.md"
#     label: "biblatex-chicago entry-type guide"

# Processing options
ocr_threshold: 100 # Minimum words extracted before OCR is attempted on key pages
ocr_timeout: 180 # Seconds to allow ocrmypdf on the extracted page subset before giving up

# Words a PDF must yield across all its pages - after OCR, where OCR ran -
# before its extraction is taken at face value. Below this the entry is marked
# amber for review, exactly as a thin webpage is: it is still produced, because
# some sources genuinely carry no bibliographic text, but it stops looking as
# confident as an entry drawn from a full title page. Must sit above
# ocr_threshold, or it could never fire. Set to 0 to disable.
thin_yield_threshold: 400
max_tokens: 4000 # Maximum tokens for Claude response
model: "claude-sonnet-4-6" # Claude model to use

# Optional: output_config.effort (low/medium/high/xhigh/max) for every call.
# Models that always think (Sonnet 5.5, Opus 5.5) count thinking tokens
# against max_tokens, so setting effort also raises every call's limit to
# thinking_max_tokens. A reply cut off at the limit fails loudly.
# effort: "medium"

# Send an entry without Langid to review (amber), for libraries that record
# the language of every entry.
# require_langid: true

# Check each entry against biblatex-chicago's data model with biber (needs
# pdflatex and biber; skipped with a note where they are missing). A field
# biber rejects for the entry type, or a missing mandatory one, sends the
# entry to review (amber) and is noted in a "% VALIDATION:" comment.
validate_entries: true
# thinking_max_tokens: 16000
# audit_max_tokens: 600   # the grounding audit's own limit

# Model used automatically for source files placed in pdf-in/careful/ during
# an --all run, instead of `model` above. Replaces having to notice a
# reference-work source (Grove, the Stanford Encyclopedia, Wikipedia) and
# react in time to change a dropdown: drop the file in the subfolder instead.
# See the operator note in CLAUDE.md.
careful_model: "claude-opus-5"

# Prompt cache TTL for the shared static context. "1h" costs 2x base input to
# write (vs 1.25x for the 5-minute default) but survives between separate
# Quick Action invocations, which is the cheaper trade unless you always
# process files in one large batch. Set to "5m" for the short tier, or to an
# empty value to use the API default.
cache_ttl: "1h"
default_ocr_language: "eng"  # Tesseract language code used when interactive_ocr is false
interactive_ocr: true  # false: never show the OCR-language dropdown, always use
  # default_ocr_language instead. Independent of verbose - dev/eval/run.py sets
  # this to false so a scanned sample source can't stall an unattended eval run
  # on a dialog nobody's there to answer, while still logging normally.

# Enrichment: fill in fields the PDF itself doesn't contain (volume, issue,
# page range, chapter) via CrossRef and/or Google Scholar (ScrapingDog).
# Entries still missing required fields afterward are saved with a leading
# "% INCOMPLETE: ..." comment rather than blocked.
enrich_missing_fields: true
crossref_email: "" # Optional: your email, for CrossRef's "polite pool" (faster, more reliable)
# Optional: ScrapingDog API key for Google Scholar fallback lookups (paid,
# https://scrapingdog.com). As above, a command is preferred to the key itself.
# scrapingdog_api_key_command: "security find-generic-password -s ostracon-scrapingdog-api-key -w"
scrapingdog_api_key: ""
# Optional: Gemini API key for Google-grounded answers in attribute search
# (src/attribute_search.py). Grounding needs a billed Google AI Studio project:
# 5,000 free searches a month, then paid. A command is preferred to the key.
# gemini_api_key_command: "security find-generic-password -s ostracon-gemini-api-key -w"
gemini_api_key: ""
# Let Gemini, grounded in Google Search, decide the entry type and answer the
# closed questions in gemini_questions_file (off by default; each source then
# makes three Gemini calls, about 15-20 s each).
gemini_type_check: false
# gemini_model: "gemini-3.8-flash"
# gemini_questions_file: "./prompt-context/gemini-questions.yaml"

# Logging
verbose: true

# Presentation only - none of this affects extraction. A top-level key of the
# same name (show_window, window_models, notifications) is still read for one
# release, with a deprecation warning, if this block is absent or omits it.
interface:
  show_window: false  # Floating progress window (overridden by --window / --no-window flags)
  # Models offered in the progress window's dropdown, so the Finder Quick
  # Action can reach a stronger model without a command line. The first entry
  # is only a default if `model` above is absent from the list. Switching
  # mid-batch applies from the next file and is inexpensive - prompt caches
  # are per-model and coexist, so a run that alternates pays one cache write
  # per model, not one per switch. See the README's Cost Estimate section.
  window_models:
    - "claude-sonnet-4-6"
    - "claude-opus-5"
  notifications: false  # Send macOS notifications (batch progress updates and validation failures)

# BibDesk integration
autofile_bibdesk: false  # After saving each entry, import it into BibDesk and auto-file the linked PDF.
                         # BibDesk will be launched and the bib file opened automatically if needed.
